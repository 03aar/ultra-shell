# NUCLEUS Environment Configuration
# Copy to .env and adjust as needed.

# ── Infrastructure ──────────────────
NUCLEUS_REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://nucleus:nucleus@localhost:5432/nucleus?sslmode=disable

# ── API Server ──────────────────────
PORT=8080

# ── Dashboard ───────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1
NEXT_PUBLIC_API_KEY=dev-nucleus-key-local

# ── Nucleus Core ────────────────────
NUCLEUS_DATA_DIR=~/.nucleus/data
RUST_LOG=info

# ── AI Providers ──────────────────────────────────────
# Nucleus uses YOUR LLM keys. Set one or more to enable:
#   - Natural language command translation (nuc ask "...")
#   - Agent orchestration (nucleus-agent run "...")
#   - Goal planning (nuc plan "...")
#
# Priority order: Anthropic > OpenAI > Google > Ollama (local)
# You only need ONE provider. All are optional.

# Anthropic Claude (recommended — best tool use)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (GPT-4o, o1, o3-mini)
# OPENAI_API_KEY=sk-proj-...

# Google Gemini
# GOOGLE_API_KEY=AI...

# Ollama — local LLMs, no API key needed
# Just run: ollama serve
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3
