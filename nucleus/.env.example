# NUCLEUS Environment Configuration
# Copy to .env and adjust as needed.

# ── Infrastructure ──────────────────
NUCLEUS_REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://nucleus:nucleus@localhost:5432/nucleus?sslmode=disable

# ── API Server ──────────────────────
PORT=8080

# ── Dashboard ───────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1
NEXT_PUBLIC_API_KEY=dev-nucleus-key-local

# ── Nucleus Core ────────────────────
NUCLEUS_DATA_DIR=~/.nucleus/data
RUST_LOG=info

# ── AI Providers (for agent orchestration) ──
# Add your API keys to enable agent features.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AI...

# ── Ollama (local LLM) ─────────────
# OLLAMA_HOST=http://localhost:11434
